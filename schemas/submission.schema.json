{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greyzone:leaderboard-submission:3",
  "title": "GreyZone leaderboard submission",
  "description": "One round of the GreyZone v1.0.1 benchmark. Each attack scenario must have a slot with an Oracle evaluation or null. Historical version 2 files are retained for the published initial results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submissionVersion",
    "benchmark",
    "attacker",
    "budget",
    "submittedBy",
    "date",
    "artifacts"
  ],
  "properties": {
    "submissionVersion": {
      "type": "integer",
      "enum": [
        2,
        3
      ]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "v1.0.1",
          "description": "Benchmark release tag the campaign ran."
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "Optional commit of that release (prefix of bcc42f1391115d5060e41e54c402aba1c9b80685)."
        }
      }
    },
    "attacker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "frameworkVersion",
        "model",
        "adapter"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,39}$",
          "description": "Red-teaming service, e.g. promptfoo, pyrit, deepteam, dreadnode, or your own tool's name."
        },
        "frameworkVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Attacker (generator) model. The Oracle envelope leaves attackerModel null, so this is the record."
        },
        "adapter": {
          "enum": [
            "official",
            "custom"
          ],
          "description": "official: the adapter shipped under <range>/redteam/<framework>; custom: your own integration with the range's attacker MCP interface."
        },
        "settings": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Strategy, plugins and other settings that define the configuration."
        },
        "applications": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/properties/victim/properties/range"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "$ref": "#/properties/attacker/properties/model"
              },
              "adapter": {
                "$ref": "#/properties/attacker/properties/adapter"
              }
            }
          }
        }
      }
    },
    "victim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range"
      ],
      "properties": {
        "range": {
          "enum": [
            "shopware-claude-commerce",
            "kubectl-ai",
            "smart-home",
            "Clawith",
            "Inbox_Zero_Mail_Agent",
            "Letta_Issue_Agent",
            "ZerePy",
            "agent-openai-java-banking-assistant",
            "alpaca-mcp-server",
            "commonly"
          ]
        },
        "model": {
          "type": "string",
          "description": "Optional; must equal the range's fixed victim model in data/ranges.json."
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTurns"
      ],
      "properties": {
        "maxTurns": {
          "description": "Attack messages allowed per episode, including the first. A single integer is the legacy shared limit for both injection types.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "direct",
                "indirect"
              ],
              "properties": {
                "direct": {
                  "type": "integer",
                  "minimum": 1
                },
                "indirect": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    },
    "submittedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "artifacts": {
      "type": "string",
      "pattern": "^https?://[^/]+",
      "description": "Public location of the raw result files and the evidence they reference."
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "description": "Every episode the campaign ran: the `evaluation` object of each Oracle result file (scripts/build_submission.py keeps only the fields below).",
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "scorePolicyVersion",
          "application",
          "scenarioId",
          "episodeId",
          "runId",
          "closedAt",
          "status",
          "surfaces"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "scorePolicyVersion": {
            "const": "2"
          },
          "application": {
            "type": "string",
            "description": "Must equal victim.range."
          },
          "scenarioId": {
            "type": "string",
            "description": "An attack scenario of the range (data/ranges.json), or kubectl-ai's control."
          },
          "episodeId": {
            "type": "string",
            "minLength": 1
          },
          "runId": {
            "type": [
              "string",
              "null"
            ]
          },
          "closedAt": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "completed",
              "no_reply",
              "error"
            ]
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "inScope",
                "score"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "inScope": {
                  "type": "boolean"
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "points",
                        "maxPoints",
                        "normalized"
                      ],
                      "properties": {
                        "points": {
                          "type": "number",
                          "minimum": 0
                        },
                        "maxPoints": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "normalized": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "else": {
          "properties": {
            "surfaces": {
              "items": {
                "properties": {
                  "score": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shopware-claude-commerce",
        "kubectl-ai",
        "smart-home",
        "Clawith",
        "Inbox_Zero_Mail_Agent",
        "Letta_Issue_Agent",
        "ZerePy",
        "agent-openai-java-banking-assistant",
        "alpaca-mcp-server",
        "commonly"
      ],
      "properties": {
        "shopware-claude-commerce": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "buyer-exfil",
              "buyer-misdirection",
              "merchant-exfil",
              "merchant-floor-breach",
              "merchant-refund"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 5,
          "maxProperties": 5
        },
        "kubectl-ai": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "g1-exfil-l0-explicit-ip2-event",
              "g1-exfil-l1-note-ip1-weblog",
              "g1-exfil-l1-note-ip3-exec",
              "g1-exfil-l2-alert-ip2-event",
              "g2-escalate-l2-note-ip2-event",
              "g3-sabotage-l2-note-ip2-event"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 6,
          "maxProperties": 6
        },
        "smart-home": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "disarm-code-leak",
              "exfil-state-dump",
              "exfil-state-dump-media",
              "exfil-state-dump-ssdp",
              "exfil-state-dump-web",
              "unlock-door"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 6,
          "maxProperties": 6
        },
        "Clawith": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "chat-exfil",
              "email-exfil",
              "kb-poison",
              "private-agent-leak",
              "sandbox-escape"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 5,
          "maxProperties": 5
        },
        "Inbox_Zero_Mail_Agent": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "knowledge-leak",
              "mail-history-leak",
              "phishing-outbound"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 3,
          "maxProperties": 3
        },
        "Letta_Issue_Agent": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "memory-poisoning",
              "outbound-network-traffic",
              "runtime-credential-disclosure"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 3,
          "maxProperties": 3
        },
        "ZerePy": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "airdrop-impersonation",
              "promoter-shill",
              "refund-redirect",
              "treasury-redirect"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 4,
          "maxProperties": 4
        },
        "agent-openai-java-banking-assistant": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "direct-recon-steal",
              "indirect-invoice-pay"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 2,
          "maxProperties": 2
        },
        "alpaca-mcp-server": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "order-tamper",
              "panic-liquidation",
              "protection-pull",
              "sell-omission",
              "steered-trade",
              "unauthorized-sell"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 6,
          "maxProperties": 6
        },
        "commonly": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "forged-delete",
              "forged-dissolve",
              "forged-invite",
              "forged-kick",
              "private-pod-leak",
              "task-exfil"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          },
          "minProperties": 6,
          "maxProperties": 6
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kubectl-ai": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "control"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/optionalEvaluation"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "submissionVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "victim",
          "episodes"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scenarios"
              ]
            },
            {
              "required": [
                "controls"
              ]
            },
            {
              "properties": {
                "attacker": {
                  "required": [
                    "applications"
                  ]
                }
              }
            }
          ]
        }
      },
      "else": {
        "required": [
          "scenarios"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "victim"
              ]
            },
            {
              "required": [
                "episodes"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "optionalEvaluation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/properties/episodes/items"
        }
      ]
    }
  }
}
